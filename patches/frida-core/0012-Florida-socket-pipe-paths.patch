From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ocean-zh-Hans <ocean@example.com>
Date: Fri, 24 Jul 2026 00:00:00 +0800
Subject: [PATCH 12/16] Florida: rename socket/pipe paths

Replace "/frida-*" abstract socket paths with "/gcore-*"
to avoid detection via /proc/net/unix and /proc/self/fd/.

---
 src/android-helper/re/frida/Helper.java        | 6 +++---
 src/linux/frida-helper-backend.vala            | 2 +-
 src/linux/frida-helper-process.vala            | 2 +-
 src/linux/helpers/zymbiote.c                   | 2 +-
 src/linux/linux-host-session.vala              | 6 +++---
 src/linux/proc-mem-injector.vala               | 2 +-
 6 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/src/android-helper/re/frida/Helper.java b/src/android-helper/re/frida/Helper.java
index 37e6fbf9..ccad1fd7 100644
--- a/src/android-helper/re/frida/Helper.java
+++ b/src/android-helper/re/frida/Helper.java
@@ -22,15 +22,15 @@ public class Helper {
 		if (args.length != 1) {
-			System.err.println("Usage: frida-helper <instance-id>");
+			System.err.println("Usage: gcore-helper <instance-id>");
 			System.exit(1);
 			return;
 		}

 		String instanceId = args[0];

-		new File("/data/local/tmp/frida-helper-" + instanceId + ".dex").delete();
+		new File("/data/local/tmp/gcore-helper-" + instanceId + ".dex").delete();

 		LocalServerSocket socket;
 		try {
-			socket = new LocalServerSocket("/frida-helper-" + instanceId);
+			socket = new LocalServerSocket("/gcore-helper-" + instanceId);
 		} catch (IOException e) {
 			System.err.println(e);
 			System.exit(2);
diff --git a/src/linux/frida-helper-backend.vala b/src/linux/frida-helper-backend.vala
index ebc41042..e584fa2b 100644
--- a/src/linux/frida-helper-backend.vala
+++ b/src/linux/frida-helper-backend.vala
@@ -1252,7 +1252,7 @@ namespace Frida {

 		private static string make_fallback_address () {
-			return "/frida-" + Uuid.string_random ();
+			return "/gcore-" + Uuid.string_random ();
 		}

 		private Future<RemoteAgent> establish_connection (LoaderLaunch launch, InjectSpec spec, BootstrapResult bres,
diff --git a/src/linux/frida-helper-process.vala b/src/linux/frida-helper-process.vala
index a7daf020..4d2317ff 100644
--- a/src/linux/frida-helper-process.vala
+++ b/src/linux/frida-helper-process.vala
@@ -340,7 +340,7 @@ namespace Frida {

 			try {
-				string socket_path = "/frida-" + Uuid.string_random ();
+				string socket_path = "/gcore-" + Uuid.string_random ();
 				string socket_address = "unix:abstract=" + socket_path;

 				service = new SocketService ();
diff --git a/src/linux/helpers/zymbiote.c b/src/linux/helpers/zymbiote.c
index b9fa5268..7a00cf34 100644
--- a/src/linux/helpers/zymbiote.c
+++ b/src/linux/helpers/zymbiote.c
@@ -39,7 +39,7 @@ struct _ZymbioteContext

 ZymbioteContext zymbiote =
 {
-  .socket_path = "/frida-zymbiote-00000000000000000000000000000000",
+  .socket_path = "/gcore-zymbiote-00000000000000000000000000000000",
 };

 int frida_zymbiote_replacement_setargv0 (JNIEnv * env, jobject clazz, jstring name);
diff --git a/src/linux/linux-host-session.vala b/src/linux/linux-host-session.vala
index aa7d26ce..4dba8772 100644
--- a/src/linux/linux-host-session.vala
+++ b/src/linux/linux-host-session.vala
@@ -482,7 +482,7 @@ namespace Frida {

 			try {
 				string instance_id = Uuid.string_random ().replace ("-", "");
-				string helper_path = "/data/local/tmp/frida-helper-" + instance_id + ".dex";
+				string helper_path = "/data/local/tmp/gcore-helper-" + instance_id + ".dex";
 				FileUtils.set_data (helper_path, Frida.Data.Android.get_helper_dex_blob ().data);
 				Posix.chmod (helper_path, 0644);

@@ -1569,7 +1569,7 @@ namespace Frida {

 			if (server_name == null) {
-				string name = "/frida-zymbiote-" + Uuid.string_random ().replace ("-", "");
+				string name = "/gcore-zymbiote-" + Uuid.string_random ().replace ("-", "");
 				var address = new UnixSocketAddress.with_type (name, -1, UnixSocketAddressType.ABSTRACT);

 				try {
@@ -2006,7 +2006,7 @@ namespace Frida {

 			unowned uint8[] payload_template = blob.data[text.file_offset:text.file_offset + text.file_size];

-			void * p = memmem (payload_template, "/frida-zymbiote-00000000000000000000000000000000".data);
+			void * p = memmem (payload_template, "/gcore-zymbiote-00000000000000000000000000000000".data);
 			assert (p != null);
 			size_t data_offset = (uint8 *) p - (uint8 *) payload_template;

