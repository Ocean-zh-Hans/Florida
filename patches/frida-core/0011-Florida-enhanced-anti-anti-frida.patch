From d02f10cda9a65dde50f895297f48fd2fd071892d Mon Sep 17 00:00:00 2001
From: Termux Build <termux@local>
Date: Fri, 24 Jul 2026 19:10:54 +0800
Subject: [PATCH] 0011: enhanced anti-anti-frida

---
 src/anti-anti-frida.py | 39 ++++++++++++++++++++++++++++++---------
 1 file changed, 30 insertions(+), 9 deletions(-)

diff --git a/src/anti-anti-frida.py b/src/anti-anti-frida.py
index 3b4cb954..06554a09 100644
--- a/src/anti-anti-frida.py
+++ b/src/anti-anti-frida.py
@@ -2,6 +2,7 @@ import lief
 import sys
 import random
 import os
+import re
 
 def log_color(msg):
     print(f"\033[1;31;40m{msg}\033[0m")
@@ -16,19 +17,27 @@ if __name__ == "__main__":
         log_color(f"[*] Not elf, exit")
         exit()
 
+    # Stage 1: Symbol patching
     random_name = "".join(random.sample(random_charset, 5))
     log_color(f"[*] Symbol: patch `frida` prefix to `{random_name}`")
 
     for symbol in binary.symbols:
-        if symbol.name == "frida_agent_main":
+        if symbol.name in ("frida_agent_main", "_frida_agent_main"):
             symbol.name = "main"
-        if "frida" in symbol.name:
-            symbol.name = symbol.name.replace("frida", random_name)
-        if "FRIDA" in symbol.name:
-            symbol.name = symbol.name.replace("FRIDA", random_name)
+        if symbol.name.startswith("frida_") or symbol.name.startswith("_frida_"):
+            stem = symbol.name
+            if stem.startswith("_"):
+                stem = stem[1:]
+            symbol.name = stem.replace("frida", random_name, 1)
+        if symbol.name.startswith("Frida"):
+            symbol.name = symbol.name.replace("Frida", "Gbond", 1)
+        if symbol.name.startswith("FRIDA"):
+            symbol.name = symbol.name.replace("FRIDA", random_name.upper(), 1)
+        if symbol.name.startswith("frida"):
+            symbol.name = symbol.name.replace("frida", random_name, 1)
 
-    # .rodata string reversal
-    all_patch_string = ["FridaScriptEngine", "GLib-GIO", "GDBusProxy", "GumScript"]
+    # Stage 2: .rodata string reversal
+    all_patch_string = ["FridaScriptEngine", "GLib-GIO", "GDBusProxy", "GumScript", "Frida"]
     for section in binary.sections:
         if section.name != ".rodata":
             continue
@@ -41,10 +50,22 @@ if __name__ == "__main__":
 
     binary.write(input_file)
 
-    # Thread name randomizations
-    for name, length in [("gum-js-loop", 11), ("gmain", 5), ("gdbus", 5), ("pool-frida", 10)]:
+    # Stage 3: Thread name randomization
+    for name, length in [("gum-js-loop", 11), ("gmain", 5), ("gdbus", 5), ("pool-frida", 10), ("pool-spawner", 12), ("frida-main-loop", 15)]:
         rn = "".join(random.sample(random_charset, length))
         log_color(f"[*] Thread: `{name}` -> `{rn}`")
         os.system(f"sed -b -i s/{name}/{rn}/g {input_file}")
 
+    # Stage 4: Build path cleanup
+    log_color(f"[*] Build paths: cleaning compiler-embedded paths")
+    os.system(f"sed -b -i 's|/home/oleavr/|/dev/null/|g' {input_file}")
+    os.system(f"sed -b -i 's|/Users/runner/|/tmp/build/|g' {input_file}")
+
+    # Stage 5: Version string cleanup
+    os.system(f"sed -b -i 's|Frida/|Radar/|g' {input_file}")
+
+    # Stage 6: Final catch-all for remaining path strings
+    os.system(f"sed -b -i 's|frida-zymbiote-|gcore-zymbiote-|g' {input_file}")
+    os.system(f"sed -b -i 's|/frida-|/gcore-|g' {input_file}")
+
     log_color(f"[*] Patch Finish")
-- 
