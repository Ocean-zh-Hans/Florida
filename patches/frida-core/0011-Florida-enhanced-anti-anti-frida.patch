-    log_color(f"[*] Patch `gdbus` to `{random_name}`")
+    log_color(f"[*] Thread: `gdbus` -> `{random_name}`")
     os.system(f"sed -b -i s/gdbus/{random_name}/g {input_file}")

+    # pool-frida (10 chars)
+    random_name = "".join(random.sample(random_charset, 10))
+    log_color(f"[*] Thread: `pool-frida` -> `{random_name}`")
+    os.system(f"sed -b -i s/pool-frida/{random_name}/g {input_file}")
+
+    # pool-spawner (12 chars)
+    random_name = "".join(random.sample(random_charset, 12))
+    log_color(f"[*] Thread: `pool-spawner` -> `{random_name}`")
+    os.system(f"sed -b -i s/pool-spawner/{random_name}/g {input_file}")
+
+    # frida-main-loop (15 chars)
+    random_name = "".join(random.sample(random_charset, 15))
+    log_color(f"[*] Thread: `frida-main-loop` -> `{random_name}`")
+    os.system(f"sed -b -i s/frida-main-loop/{random_name}/g {input_file}")
+
+    # --- Stage 4: Build path cleanup ---
+    # Remove embedded build paths (compiler artifact)
+    log_color(f"[*] Build paths: cleaning compiler-embedded paths")
+    os.system(f"sed -b -i 's|/home/oleavr/|/dev/null/|g' {input_file}")
+    os.system(f"sed -b -i 's|/Users/runner/|/tmp/build/|g' {input_file}")
+
+    # --- Stage 5: Version string cleanup ---
+    # Remove "Frida/X.Y.Z" user-agent strings if present
+    # Use targeted sed to replace Frida version prefix
+    os.system(f"sed -b -i 's|Frida/|Radar/|g' {input_file}")
+
+    # --- Stage 6: Final catch-all sweep (least invasive) ---
+    # Catch any remaining "frida-" path patterns in .rodata
+    os.system(f"sed -b -i 's|frida-zymbiote-|gcore-zymbiote-|g' {input_file}")
+    os.system(f"sed -b -i 's|/frida-|/gcore-|g' {input_file}")
