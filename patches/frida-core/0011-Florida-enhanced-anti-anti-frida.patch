+
+    # --- Stage 1: Symbol patching ---
     random_name = "".join(random.sample(random_charset, 5))
-    log_color(f"[*] Patch `frida` to `{random_name}`")
+    log_color(f"[*] Symbol: patch `frida` prefix to `{random_name}`")

     for symbol in binary.symbols:
-        if symbol.name == "frida_agent_main":
+        # Rename entry point
+        if symbol.name in ("frida_agent_main", "_frida_agent_main"):
             symbol.name = "main"
-
-        if "frida" in symbol.name:
-            symbol.name = symbol.name.replace("frida", random_name)
-
-        if "FRIDA" in symbol.name:
-            symbol.name = symbol.name.replace("FRIDA", random_name)
-
-    all_patch_string = ["FridaScriptEngine", "GLib-GIO", "GDBusProxy", "GumScript"]  # 字符串特征修改 尽量与源字符一样
+
+        # Comprehensive prefix-rename for all frida/Frida FRIDA_ prefixed symbols
+        # Also handles: frida_zymbiote_*, FRIDA_AGENT_*, etc.
+        if symbol.name.startswith("frida_") or symbol.name.startswith("_frida_"):
+            stem = symbol.name
+            if stem.startswith("_"):
+                stem = stem[1:]
+            symbol.name = stem.replace("frida", random_name, 1)
+
+        if symbol.name.startswith("Frida"):
+            # GObject type symbols like FridaDevice, FridaSession, etc.
+            symbol.name = symbol.name.replace("Frida", "Gbond", 1)
+
+        if symbol.name.startswith("FRIDA"):
+            symbol.name = symbol.name.replace("FRIDA", random_name.upper(), 1)
+
+        if symbol.name.startswith("frida"):
+            # Catch any remaining lowercase frida prefix not caught above
+            symbol.name = symbol.name.replace("frida", random_name, 1)
+
+    # --- Stage 2: .rodata string reversal ---
+    all_patch_string = ["FridaScriptEngine", "GLib-GIO", "GDBusProxy", "GumScript", "Frida"]  # "Frida" catches remaining standalone refs
     for section in binary.sections:
         if section.name != ".rodata":
             continue
