-					new AgentResource ("frida-agent-arm64.so", new Bytes.static (emulated_arm64.data), tempdir),
+					new AgentResource (GLib.Uuid.string_random() + "-arm.so", new Bytes.static (emulated_arm.data), tempdir),
+					new AgentResource (GLib.Uuid.string_random() + "-arm64.so", new Bytes.static (emulated_arm64.data), tempdir),
 				},
 				AgentMode.INSTANCED,
 				tempdir);
